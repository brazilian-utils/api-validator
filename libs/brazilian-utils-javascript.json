{
  "$schema": "../schema/lib.schema.json",
  "name": "brazilian-utils-javascript",
  "language": "typescript",
  "notes": "Reference implementation.",
  "repo": "https://github.com/brazilian-utils/javascript",
  "entry": "src/index.ts",
  "ignore": ["toStandardSchema"],
  "site": {
    "label": "JavaScript",
    "order": 1,
    "package": "@brazilian-utils/brazilian-utils",
    "install": "npm install @brazilian-utils/brazilian-utils",
    "registry": "https://www.npmjs.com/package/@brazilian-utils/brazilian-utils",
    "usage": {
      "ref": "main",
      "path": "docs/usage",
      "reference": { "en": "docs/utilities.md", "pt-BR": "docs/pt-br/utilities.md" },
      "guides": { "en": "docs/guides", "pt-BR": "docs/pt-br/guides" },
      "root": "docs",
      "assets": ["docs/snippets"],
      "prepare": ["node", "scripts/examples.ts"]
    }
  }
}
