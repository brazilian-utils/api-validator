{
  "name": "api-validator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api-validator": "tsx src/cli.ts",
    "check": "tsx src/cli.ts check",
    "lint": "tsx src/cli.ts lint && tsx src/cli.ts fmt --check",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "tsx src/cli.ts sync && tsx src/cli.ts check --tests"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "marked": "^15.0.12",
    "ts-morph": "^25.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "bin": {
    "api-validator": "src/cli.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
