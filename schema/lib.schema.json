{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "language": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" },
    "repo": { "type": "string", "format": "uri" },
    "branch": { "type": "string" },
    "entry": { "default": ".", "type": "string" },
    "bindings": {
      "default": {},
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": {
        "anyOf": [{ "type": "string" }, { "minItems": 1, "type": "array", "items": { "type": "string" } }]
      }
    },
    "ignore": { "default": [], "type": "array", "items": { "type": "string" } },
    "waivers": {
      "default": {},
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "knownFailures": {
      "default": {},
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "options": { "default": {}, "type": "object", "propertyNames": { "type": "string" }, "additionalProperties": {} },
    "site": {
      "type": "object",
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "icon": { "type": "string" },
        "order": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
        "package": { "type": "string", "minLength": 1 },
        "install": { "type": "string", "minLength": 1 },
        "registry": { "type": "string", "format": "uri" },
        "usage": {
          "default": { "ref": "latest-release", "path": "docs/usage" },
          "type": "object",
          "properties": {
            "ref": { "default": "latest-release", "type": "string" },
            "path": { "default": "docs/usage", "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "required": ["label", "order", "package", "install", "registry"],
      "additionalProperties": false
    }
  },
  "required": ["name", "language"],
  "additionalProperties": false,
  "title": "brazilian-utils lib config (libs/<name>.json)"
}
