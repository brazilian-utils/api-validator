# Optional. Raises the GitHub API rate limit when fetching usage files from the library repos.
# In GitHub Actions the built-in GITHUB_TOKEN is used automatically.
GITHUB_TOKEN=

# Optional. Where the site is published. Defaults to https://brazilian-utils.com.br and "/".
SITE_URL=
BASE_PATH=

# Optional. Set to "fixtures" to skip GitHub entirely and build from fixtures/usage/ (offline mode).
USAGE_SOURCE=
