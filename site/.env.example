# Optional. Raises the GitHub API rate limit when fetching usage files from the library repos.
# In GitHub Actions the built-in GITHUB_TOKEN is used automatically.
GITHUB_TOKEN=

# Optional. The public URL, path included; its path becomes the base path of every link.
# Defaults to https://brazilian-utils.github.io/api-validator.
SITE_URL=

# Optional. Set to "fixtures" to skip GitHub entirely and build from fixtures/usage/ (offline mode).
USAGE_SOURCE=

# Optional. Without a validator run, the build downloads the last status (/status.json, badges)
# from SITE_DATA_URL (default: SITE_URL). SITE_DATA=skip builds without it.
SITE_DATA_URL=
SITE_DATA=

# Optional. Vercel builds are noindex; true lifts the meta tag (the X-Robots-Tag header lives in
# vercel.json).
SITE_INDEXABLE=
