{
  "name": "@brazilian-utils/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Documentação unificada das bibliotecas Brazilian Utils: specs canônicas + uso por linguagem.",
  "scripts": {
    "prepare:content": "node scripts/fetch-usage.mjs && node scripts/generate-pages.mjs",
    "site-data": "cd .. && node --import ./node_modules/tsx/dist/esm/index.mjs src/cli.ts site-data",
    "dev": "npm run prepare:content && astro dev",
    "build": "npm run prepare:content && astro build",
    "preview": "astro preview",
    "fetch:usage": "node scripts/fetch-usage.mjs",
    "generate:pages": "node scripts/generate-pages.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "audit": "npm audit --audit-level=low",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.0",
    "astro": "7.3.2",
    "sharp": "0.35.4"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  }
}
