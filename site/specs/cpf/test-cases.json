{
  "spec": "cpf",
  "version": "1.0.0",
  "utils": [
    {
      "name": "is valid",
      "cases": [
        { "in": "123.456.789-09", "out": true },
        { "in": "111.444.777-35", "out": true },
        { "in": "123.456.789-00", "out": false },
        { "in": "111.444.777-00", "out": false },
        { "in": "12345678909", "out": true },
        { "in": "11144477735", "out": true },
        { "in": "12345678900", "out": false },
        { "in": "11144477700", "out": false },
        { "in": "000.000.000-00", "out": false },
        { "in": "111.111.111-11", "out": false },
        { "in": "222.222.222-22", "out": false },
        { "in": "333.333.333-33", "out": false },
        { "in": "444.444.444-44", "out": false },
        { "in": "555.555.555-55", "out": false },
        { "in": "666.666.666-66", "out": false },
        { "in": "777.777.777-77", "out": false },
        { "in": "888.888.888-88", "out": false },
        { "in": "999.999.999-99", "out": false }
      ]
    },{
      "name": "format",
      "cases": [
        { "in": "12345678909", "out": "123.456.789-09" },
        { "in": "11144477735", "out": "111.444.777-35" },
        { "in": "123.456.789-09", "out": "123.456.789-09" },
        { "in": "111.444.777-35", "out": "111.444.777-35" }
      ]
    },
    {
      "name": "remove symbols",
      "cases": [
        { "in": "123.456.789-09", "out": "12345678909" },
        { "in": "111.444.777-35", "out": "11144477735" },
        { "in": "12345678909", "out": "12345678909" },
        { "in": "11144477735", "out": "11144477735" }
      ]
    },
    {
      "name": "generate",
      "cases": [
        { "in": null, "out": "any valid cpf", "assert": "is valid" },
        { "in": { "formatted": true }, "out": "any valid formatted cpf", "assert": "is valid" }
      ]
    }
  ]
}
