---
/**
 * The shared test cases of one contract operation, with each library's result from the last
 * api-validator run: the cases every implementation must pass.
 */
import { loadLibs, loadSpec, loadStatus } from '@lib/registry.mjs';
import { CASE_MARK, expectation, testIds } from '@lib/text.mjs';

interface Props {
  util: string;
  op: string;
}

const { util, op } = Astro.props;
const t = Astro.locals.t;
const operation = loadSpec(util)?.operations.find((o) => o.id === op);
const tests = operation?.tests ?? [];
const ids = operation ? testIds(operation.fnId, tests) : [];
const status = loadStatus();
const libs = status ? loadLibs().filter((lib) => status.libs[lib.id]) : [];

function result(libId: string, caseId: string) {
  const f = status?.libs[libId]?.functions?.[operation!.fnId];
  if (!f || f.status === 'missing' || f.status === 'waived') return { cls: 'bu-none', mark: '–', label: t(`status.${f?.status === 'waived' ? 'waived' : 'missing'}`) };
  const r = f.results?.[caseId];
  if (!r) return { cls: 'bu-none', mark: '–', label: t('cases.notRun') };
  return { cls: r === 'pass' ? 'bu-ok' : r === 'skip' ? 'bu-none' : 'bu-fail', mark: CASE_MARK[r as keyof typeof CASE_MARK] ?? '–', label: t(`cases.${r}` as any) };
}

const show = (v: unknown) => JSON.stringify(v ?? []).slice(1, -1);
// Starlight lets a wide table scroll: tabindex makes it reachable by keyboard, the label names it.
---

{tests.length === 0 ? (
  <p class="no-cases">{t('testcases.none')}</p>
) : (
  <details class="cases">
    <summary>{t('cases.summary', { count: tests.length })}</summary>
    <table tabindex="0" aria-label={`${t('cases.summary', { count: tests.length })}: ${operation!.fnId}`}>
        <thead>
          <tr>
            <th scope="col">{t('testcases.input')}</th>
            <th scope="col">{t('testcases.expected')}</th>
            {libs.map((lib) => <th scope="col" class="lib">{lib.label}</th>)}
          </tr>
        </thead>
        <tbody>
          {tests.map((test: any, i: number) => (
            <tr>
              <td>
                <code>{show(test.args)}</code>
                {test.repeat > 1 && <span class="muted"> ×{test.repeat}</span>}
                {test.note && <div class="note">{test.note}</div>}
              </td>
              <td><code>{expectation(test)}</code></td>
              {libs.map((lib) => {
                const r = result(lib.id, ids[i]);
                return (
                  <td class="mark">
                    <span class={r.cls} aria-hidden="true" title={r.label}>{r.mark}</span>
                    <span class="sr-only">{r.label}</span>
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
    </table>
  </details>
)}

<style>
  .cases summary {
    cursor: pointer;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  table {
    font-size: var(--sl-text-sm);
  }
  .lib,
  .mark {
    text-align: center;
    white-space: nowrap;
  }
  .note {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    margin-top: 0.2rem;
  }
  .muted,
  .no-cases {
    color: var(--sl-color-gray-3);
  }
  .no-cases {
    font-size: var(--sl-text-sm);
  }
</style>
