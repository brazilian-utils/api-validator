---
/**
 * Top of a library guide: which library it comes from (and its source file in this language), a
 * note when the library has no translation of it, and the contract operations it calls.
 */
import { loadGuides, loadLibs, loadSpecs } from '@lib/registry.mjs';
import { opPath } from '@lib/text.mjs';
import { pageContext } from '@lib/page';

interface Props {
  lib: string;
  slug: string;
  /** Language the guide is shown in (the library may not have this page's language). */
  shown: string;
  /** The guide's file in the library, in the language shown. */
  source: string;
}
const { lib: libId, slug, shown, source } = Astro.props;
const t = Astro.locals.t;
const { locale, prefix } = pageContext(Astro);
const lib = loadLibs().find((l) => l.id === libId)!;
const guide = loadGuides().find((g) => g.lib === libId && g.slug === slug)!;
const specs = loadSpecs();
const uses = guide.fns.flatMap((fnId: string) => {
  const spec = specs.find((s) => s.operations.some((o) => o.fnId === fnId));
  const op = spec?.operations.find((o) => o.fnId === fnId);
  return spec && op ? [{ href: opPath(prefix, spec, op, locale), label: `${spec.title[locale]}: ${op.label[locale]}` }] : [];
});
---

<div class="guide-header not-content">
  <p>
    {t('guide.from', { lib: lib.label })} <a href={source} rel="noopener noreferrer">{t('guide.source')}</a>
  </p>
  {shown !== locale && <p class="fallback">{t('guide.englishOnly')}</p>}
  {uses.length > 0 && (
    <div class="uses">
      <p id={`uses-${slug}`}>{t('guide.uses')}</p>
      <ul aria-labelledby={`uses-${slug}`}>
        {uses.map((u) => <li><a href={u.href}>{u.label}</a></li>)}
      </ul>
    </div>
  )}
</div>

<style>
  .guide-header {
    display: grid;
    gap: 0.6rem;
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  p {
    margin: 0;
  }
  a {
    color: var(--bu-link);
  }
  .fallback {
    font-style: italic;
  }
  .uses {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    align-items: baseline;
  }
  .uses p {
    color: var(--sl-color-gray-3);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    margin: 0;
  }
</style>
