---
/**
 * Extends Starlight's <Head> with one small inline script:
 *
 * 1. Remember the language the reader picks in the language selector (localStorage "bu:lang").
 * 2. On English pages, if the reader has no saved preference and the browser prefers Portuguese,
 *    redirect once to the same page under /pt-br/ and save that as the preference.
 *
 * The site is static, so this is the only place where the browser language can be honoured.
 * Crawlers do not run the script, so the English root stays indexable.
 */
import Default from '@astrojs/starlight/components/Head.astro';

const { lang } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ptPrefix = `${base}/pt-br`;
const shouldDetect = lang !== 'pt-BR';
---

<Default><slot /></Default>

<script>
  // Expressive Code makes a code block that scrolls sideways focusable, as role="region" without
  // a name. Several unnamed regions on one page are ambiguous for screen readers: name each one
  // after its file title, or its language.
  const code = document.documentElement.lang.startsWith('pt') ? 'Código' : 'Code';
  const used = new Map<string, number>();
  /** The last heading before the element, the section it belongs to. */
  const section = (el: Element) => {
    const headings = [...document.querySelectorAll('.sl-markdown-content :is(h2, h3)')];
    return headings.filter((h) => h.compareDocumentPosition(el) & Node.DOCUMENT_POSITION_FOLLOWING).pop()?.textContent?.trim();
  };
  const name = (pre: Element) => {
    if (pre.getAttribute('role') !== 'region' || pre.hasAttribute('aria-label')) return;
    const title = pre.closest('figure')?.querySelector('.title')?.textContent?.trim();
    const lang = pre.getAttribute('data-language');
    const tab = pre.closest('[role="tabpanel"]')?.getAttribute('aria-labelledby');
    const parts = [title ?? (lang && lang !== 'plaintext' ? `${code} (${lang})` : code), tab && document.getElementById(tab)?.textContent?.trim(), section(pre)];
    let label = [...new Set(parts.filter(Boolean))].join(', ');
    const n = (used.get(label) ?? 0) + 1;
    used.set(label, n);
    if (n > 1) label += ` (${n})`;
    pre.setAttribute('aria-label', label);
  };
  new MutationObserver((changes) => changes.forEach((c) => name(c.target as Element))).observe(document.body, {
    subtree: true,
    attributeFilter: ['role'],
  });
</script>

<script is:inline define:vars={{ base, ptPrefix, shouldDetect }}>
  (function () {
    var KEY = 'bu:lang';

    // 1. Persist the reader's explicit choice from Starlight's language selector.
    document.addEventListener(
      'change',
      function (event) {
        var target = event.target;
        if (!target || !target.closest || !target.closest('starlight-lang-select')) return;
        try {
          var value = String(target.value || '');
          localStorage.setItem(KEY, value === ptPrefix || value.indexOf(ptPrefix + '/') === 0 ? 'pt-br' : 'en');
        } catch (e) {}
      },
      true,
    );

    // 2. First visit on an English page: follow the browser language once.
    if (!shouldDetect) return;
    try {
      if (localStorage.getItem(KEY)) return; // an explicit choice always wins
      var langs = navigator.languages || [navigator.language || ''];
      var wantsPt = false;
      for (var i = 0; i < langs.length; i++) {
        var l = String(langs[i]);
        if (/^pt\b/i.test(l)) { wantsPt = true; break; } // first preference decides
        if (/^en\b/i.test(l)) break;
      }
      if (!wantsPt) return;
      var path = location.pathname;
      if (path === ptPrefix || path.indexOf(ptPrefix + '/') === 0) return;
      var rest = base && path.indexOf(base) === 0 ? path.slice(base.length) : path;
      localStorage.setItem(KEY, 'pt-br'); // never check again
      location.replace(ptPrefix + rest + location.search + location.hash);
    } catch (e) {
      /* no storage available: stay in English */
    }
  })();
</script>
