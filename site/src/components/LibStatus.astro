---
/**
 * Status page of one library, from the last api-validator run: a summary, the library next to the
 * others, what to do next (failing first, then signatures, then missing core, then missing
 * extended, each ordered by how many other libraries already have it), the failing cases, the
 * functions without a usage example, and public API outside the contract.
 */
import { Aside } from '@astrojs/starlight/components';
import { loadLibs, loadSpecs, loadStatus } from '@lib/registry.mjs';
import { isImplemented, opPath } from '@lib/text.mjs';
import { BASE, RAW, pageContext } from '@lib/page';

interface Props {
  lib: string;
}

const { lib: libId } = Astro.props;
const t = Astro.locals.t;
const { locale, prefix } = pageContext(Astro);
const libs = loadLibs();
const lib = libs.find((l) => l.id === libId)!;
const status = loadStatus();
const mine = status?.libs[libId];

// contract function id -> its operation on the site
const where = new Map<string, { href: string; label: string }>();
for (const spec of loadSpecs()) {
  for (const op of spec.operations) where.set(op.fnId, { href: opPath(prefix, spec, op, locale), label: `${spec.title[locale]}: ${op.label[locale]}` });
}
const implementedBy = (fnId: string) => libs.filter((o) => o.id !== libId && isImplemented(status?.libs[o.id]?.functions?.[fnId])).map((o) => o.label);

const rank = (f: any) => ({ failing: 0, signature: 1, missing: f.level === 'core' ? 2 : 3 } as Record<string, number>)[f.status] ?? 9;
const fns = Object.entries((mine?.functions ?? {}) as Record<string, any>);
const work = fns
  .filter(([, f]) => rank(f) < 9)
  .map(([id, f]) => ({ id, f, by: implementedBy(id) }))
  .sort((a, b) => rank(a.f) - rank(b.f) || b.by.length - a.by.length || a.id.localeCompare(b.id));
const failures = fns.flatMap(([id, f]) => (f.failures ?? []).map((x: any) => ({ fn: id, ...x })));
const undocumented = fns.filter(([, f]) => isImplemented(f) && f.usage && !f.usage.documented);
const others = status ? libs.filter((l) => status.libs[l.id]).sort((a, b) => status.libs[b.id].summary.coreCoverage - status.libs[a.id].summary.coreCoverage) : [];
const s = mine?.summary;
const show = (v: unknown) => (v === undefined || v === null ? 'null' : JSON.stringify(v));
const external = { rel: 'noopener noreferrer' };
---

<dl class="facts not-content">
  <dt>{t('lib.repository')}</dt>
  <dd><a href={`https://github.com/${lib.repo}`} {...external}>github.com/{lib.repo}</a>{mine?.revision && <> <code>{mine.revision.slice(0, 7)}</code></>}</dd>
  <dt>{t('lib.package')}</dt>
  <dd><a href={lib.registry} {...external}>{lib.package}</a></dd>
  <dt>{t('libs.install')}</dt>
  <dd><code>{lib.install}</code></dd>
  {mine && (
    <>
      <dt>{t('lib.badge')}</dt>
      <dd><img src={`${BASE}/badges/${lib.id}.svg`} alt={t('lib.badgeAlt', { ...RAW, core: s.coreCoverage, passed: s.testsPassed })} height="20" /></dd>
    </>
  )}
</dl>

{!mine ? (
  <Aside type="note">{t('lib.noStatus')}</Aside>
) : (
  <>
    <p class="summary">
      {t('lib.summary', { ...RAW, lib: lib.label, done: s.ok + s.failing, total: s.total, core: s.coreCoverage })}{' '}
      {t('lib.summaryCases', { ...RAW, passed: s.testsPassed, failed: s.testsFailed })}{' '}
      {s.signature > 0 && t('lib.summarySignatures', { ...RAW, count: s.signature })}{' '}
      {mine.unmapped.length > 0 && t('lib.summaryOutside', { ...RAW, count: mine.unmapped.length })}
    </p>

    <h2 id="compare">{t('lib.compare')}</h2>
    <div class="table-wrap not-content">
      <table>
        <thead>
          <tr><th scope="col">{t('lib.library')}</th><th scope="col">{t('lib.core')}</th><th scope="col">{t('lib.implemented')}</th><th scope="col">{t('lib.passing')}</th></tr>
        </thead>
        <tbody>
          {others.map((o) => {
            const os = status.libs[o.id].summary;
            return (
              <tr class:list={[{ me: o.id === libId }]}>
                <th scope="row">{o.id === libId ? o.label : <a href={`${prefix}/libs/${o.id}/`}>{o.label}</a>}</th>
                <td class="num"><span class="bar" aria-hidden="true"><i style={`width:${os.coreCoverage}%`} /></span> {os.coreCoverage}%</td>
                <td class="num">{os.ok + os.failing}/{os.total}</td>
                <td class="num">{os.testsPassed}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <h2 id="work">{t('lib.work')}</h2>
    <p>{t('lib.workIntro')}</p>
    {work.length === 0 ? <p>{t('lib.workDone')}</p> : (
      <div class="table-wrap not-content">
        <table>
          <thead>
            <tr><th scope="col">{t('lib.function')}</th><th scope="col">{t('lib.status')}</th><th scope="col">{t('lib.why')}</th><th scope="col">{t('lib.implementedBy')}</th></tr>
          </thead>
          <tbody>
            {work.map(({ id, f, by }) => (
              <tr>
                <td>
                  <a href={where.get(id)?.href}>{where.get(id)?.label ?? id}</a>
                  <div class="muted"><code>{id}</code>{f.level === 'core' && ` ${t('lib.coreTag')}`}</div>
                </td>
                <td title={t(`status.${f.status}` as any)} class:list={['nowrap', { 'bu-fail': f.status === 'failing', 'bu-warn': f.status === 'signature', 'bu-none': f.status === 'missing' }]}>{t(`status.short.${f.status}` as any)}</td>
                <td class="small">{f.status === 'failing' ? t('status.failedCases', { ...RAW, count: f.failed }) : f.status === 'signature' ? f.issues.join('. ') : f.suggestions?.length ? t('lib.maybe', { ...RAW, symbols: f.suggestions.join(', ') }) : ''}</td>
                <td class="small">{by.length ? `${by.length}: ${by.join(', ')}` : t('lib.nobody')}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    {failures.length > 0 && (
      <>
        <h2 id="failures">{t('lib.failures')}</h2>
        <div class="table-wrap not-content">
          <table>
            <thead><tr><th scope="col">{t('lib.case')}</th><th scope="col">{t('testcases.expected')}</th><th scope="col">{t('lib.actual')}</th></tr></thead>
            <tbody>
              {failures.map((x) => (
                <tr><td><a href={where.get(x.fn)?.href}><code>{x.id}</code></a></td><td><code>{show(x.expected)}</code></td><td><code>{x.actual === null && x.message ? x.message : show(x.actual)}</code></td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )}

    {undocumented.length > 0 && (
      <>
        <h2 id="undocumented">{t('lib.undocumented')}</h2>
        <p>{t('lib.undocumentedIntro')}</p>
        <ul>{undocumented.map(([id]) => <li><a href={where.get(id)?.href}>{where.get(id)?.label ?? id}</a> <code>{id}</code></li>)}</ul>
      </>
    )}

    {mine.unmapped.length > 0 && (
      <>
        <h2 id="outside">{t('lib.outsideTitle')}</h2>
        <p>{t('lib.outsideIntro')}</p>
        <ul>{mine.unmapped.map((u: any) => <li><code>{u.symbol}</code>{u.suggestions.length > 0 && <span class="muted"> {t('lib.maybe', { ...RAW, symbols: u.suggestions.join(', ') })}</span>}</li>)}</ul>
      </>
    )}
  </>
)}

<style>
  .facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.35rem 1.25rem;
    margin: 0 0 1.5rem;
    font-size: var(--sl-text-sm);
  }
  .facts dt {
    color: var(--sl-color-gray-3);
  }
  .facts dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .facts a {
    color: var(--bu-link);
  }
  .facts img {
    vertical-align: middle;
  }
  .summary {
    font-size: var(--sl-text-lg);
    max-width: 62ch;
  }
  .table-wrap {
    overflow-x: auto;
  }
  table {
    width: 100%;
    font-size: var(--sl-text-sm);
  }
  th,
  td {
    text-align: start;
  }
  tbody th {
    font-weight: 400;
  }
  tr.me > * {
    background: var(--sl-color-accent-low);
    font-weight: 700;
  }
  .num,
  .nowrap {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .bar {
    display: inline-block;
    width: 90px;
    height: 7px;
    background: var(--sl-color-gray-5);
    overflow: hidden;
    vertical-align: middle;
  }
  .bar i {
    display: block;
    height: 100%;
    background: var(--bu-brand-green);
  }
  .muted {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }
  .small {
    font-size: var(--sl-text-xs);
  }
</style>
