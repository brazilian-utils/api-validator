---
/**
 * A library's live demo (an HTML page it ships, copied to public/lib-assets/<lib>/), embedded
 * below a guide example. The iframe loads when it is first shown (demos inside hidden tabs cost
 * nothing) and takes the height the demo reports with
 * `parent.postMessage({ type: 'example-height', height }, origin)`.
 */
import { BASE, RAW } from '@lib/page';

interface Props {
  src: string;
  title?: string;
}
const { src, title } = Astro.props;
const t = Astro.locals.t;
const url = /^https?:\/\//.test(src) ? src : `${BASE}${src}`;
---

<figure class="live-demo not-content">
  <figcaption>
    <span class="dot" aria-hidden="true"></span>{title ? t('guide.liveDemoOf', { ...RAW, title }) : t('guide.liveDemo')}
    <a href={url} target="_blank" rel="noopener">{t('guide.openDemo')}{title && <span class="sr-only"> ({title})</span>}</a>
  </figcaption>
  <iframe src={url} title={`${t('guide.liveDemo')}${title ? `: ${title}` : ''}`} loading="lazy" height="160"></iframe>
</figure>

<script>
  addEventListener('message', (event) => {
    if (event.origin !== location.origin || event.data?.type !== 'example-height') return;
    for (const frame of document.querySelectorAll<HTMLIFrameElement>('.live-demo iframe')) {
      if (frame.contentWindow === event.source) frame.style.height = `${Math.max(80, Number(event.data.height) || 0)}px`;
    }
  });
</script>

<style>
  .live-demo {
    margin: 1rem 0;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    overflow: hidden;
    background: var(--sl-color-bg-nav);
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    border-bottom: 1px solid var(--sl-color-hairline);
  }
  figcaption a {
    margin-inline-start: auto;
    color: inherit;
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--bu-brand-green);
  }
  iframe {
    display: block;
    width: 100%;
    border: 0;
    background: #fff;
    color-scheme: light;
  }
</style>
