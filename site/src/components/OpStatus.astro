---
/**
 * Under each operation: its status in every library, from the last api-validator run
 * (.generated/status.json). Each entry links to the library's status page. Nothing without a run.
 */
import { loadLibs, loadStatus } from '@lib/registry.mjs';
import { STATUS_CLASS, STATUS_MARK } from '@lib/text.mjs';
import { RAW, pageContext } from '@lib/page';

interface Props {
  fn: string;
}

const { fn } = Astro.props;
const t = Astro.locals.t;
const { prefix } = pageContext(Astro);
const status = loadStatus();
const entries = status ? loadLibs().map((lib) => ({ lib, f: status.libs[lib.id]?.functions?.[fn] })).filter(({ f }) => f) : [];
---

{entries.length > 0 && (
  <ul class="op-status not-content" aria-label={t('status.label')}>
    {entries.map(({ lib, f }) => (
      <li>
        <a href={`${prefix}/libs/${lib.id}/`} title={[t(`status.${f.status}` as any), f.symbol].filter(Boolean).join(' · ')}>
          <span class={STATUS_CLASS[f.status as keyof typeof STATUS_CLASS]} aria-hidden="true">{STATUS_MARK[f.status as keyof typeof STATUS_MARK]}</span>
          {lib.label}
          <span class="sr-only">: {t(`status.${f.status}` as any)}</span>
          {f.status === 'failing' && <span class="bu-fail">{t('status.failedCases', { ...RAW, count: f.failed })}</span>}
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .op-status {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 1rem;
    font-size: var(--sl-text-sm);
  }
  li {
    margin: 0;
  }
  a {
    display: inline-flex;
    gap: 0.35rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
</style>
