---
/**
 * On a Portuguese page, a note when some function descriptions of the utility exist only in
 * English (the contract's `description` has no `pt-BR` yet). Nothing when all are translated.
 */
import { loadSpec } from '@lib/registry.mjs';
import { pageContext } from '@lib/page';

interface Props {
  util: string;
}
const { util } = Astro.props;
const t = Astro.locals.t;
const { locale } = pageContext(Astro);
const untranslated =
  locale !== 'en' && (loadSpec(util)?.operations ?? []).some((op) => (op.description ?? op.summary) && !(op.description ?? op.summary)?.[locale]);
---

{untranslated && <p class="ops-intro">{t('ops.englishOnly')}</p>}

<style>
  .ops-intro {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
