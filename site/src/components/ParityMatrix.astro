---
/**
 * Utility × library matrix. With a validator run (.generated/status.json): how many of the
 * domain's functions each library implements, and whether they pass the shared cases. Without
 * it: how many functions each library documents in its usage files.
 */
import { CATEGORIES, coverage, loadLibs, loadSpecs, loadStatus, loadUsageManifest } from '@lib/registry.mjs';
import { STATUS_MARK } from '@lib/text.mjs';
import { RAW, pageContext } from '@lib/page';

const t = Astro.locals.t;
const { locale, prefix } = pageContext(Astro);
const libs = loadLibs();
const specs = loadSpecs();
const status = loadStatus();
const manifest = loadUsageManifest();

function cell(spec: any, libId: string) {
  const c = coverage(spec, libId);
  const detail = c.detail.map((d: any) => `${STATUS_MARK[d.status as keyof typeof STATUS_MARK] ?? '–'} ${d.op.label[locale]}`).join('\n');
  return { ...c, detail };
}

const groups = CATEGORIES.map((c: any) => ({ c, specs: specs.filter((s: any) => s.category === c.id) })).filter((g: any) => g.specs.length);
// Marks: text first, color second. The legend is built from the same map.
const MARKS: Array<[state: string, mark: string, cls: string]> = [['full', '✓', 'bu-ok'], ['partial', '◐', 'bu-warn'], ['failing', '✕', 'bu-fail'], ['none', '○', 'bu-none']];
const mark = Object.fromEntries(MARKS.map(([state, m, cls]) => [state, { m, cls }]));
---

<div class="parity not-content">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">{t('parity.utility')}</th>
          {libs.map((lib) => <th scope="col"><a href={`${prefix}/libs/${lib.id}/`}>{lib.label}</a></th>)}
        </tr>
      </thead>
      <tbody>
        {groups.map(({ c, specs }: any) => (
          <>
            <tr class="group"><th colspan={libs.length + 1} scope="colgroup">{c.label[locale]}</th></tr>
            {specs.map((spec: any) => (
              <tr>
                <th scope="row"><a href={`${prefix}/utils/${spec.id}/`}>{spec.title[locale]}</a></th>
                {libs.map((lib) => {
                  const x = cell(spec, lib.id);
                  return (
                    <td class="cell" title={x.detail}>
                      <span class={`mark ${mark[x.state].cls}`} aria-hidden="true">{mark[x.state].m}</span>
                      <span class="sr-only">{t(`parity.${x.state}` as any)}</span>
                      {x.state !== 'none' && <span class="count">{x.count}/{x.total}</span>}
                    </td>
                  );
                })}
              </tr>
            ))}
          </>
        ))}
      </tbody>
    </table>
  </div>

  <p class="legend">
    <span>{t('parity.legend')}:</span>
    {MARKS.filter(([state]) => status || state !== 'failing').map(([state, m, cls]) => (
      <span><span class={cls} aria-hidden="true">{m}</span> {t(`parity.${state}` as any)}</span>
    ))}
  </p>
  <p class="fetched">
    {status ? t('parity.fromRun', { ...RAW, date: new Date(status.generatedAt).toLocaleString(locale) }) : manifest?.fetchedAt ? `${t('parity.fetchedAt')} ${new Date(manifest.fetchedAt).toLocaleString(locale)}.` : ''}
  </p>
</div>

<style>
  .table-wrap { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: var(--sl-text-sm); }
  th, td { padding: 0.45rem 0.7rem; border-bottom: 1px solid var(--sl-color-hairline); text-align: start; white-space: nowrap; }
  thead th { font-weight: 400; color: var(--sl-color-gray-3); }
  thead a, tbody th a { color: var(--bu-link); }
  tbody th { font-weight: 400; }
  tr.group th { padding-top: 1.1rem; font-weight: 700; color: var(--sl-color-white); border-bottom-color: var(--sl-color-gray-5); }
  .cell { font-variant-numeric: tabular-nums; }
  .mark { display: inline-block; width: 1.1em; }
  .count { color: var(--sl-color-gray-3); font-size: var(--sl-text-xs); }
  .legend { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; font-size: var(--sl-text-sm); margin-top: 1rem; }
  .fetched { font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); }
</style>
