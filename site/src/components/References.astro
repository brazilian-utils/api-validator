---
/**
 * Official sources for a utility: the links in contract/<domain>/references.md, the references of
 * each operation in the contract, and any PDF copies kept in contract/<domain>/references/.
 */
import { loadReferences, loadReferenceFiles } from '@lib/registry.mjs';

interface Props {
  util: string;
}

const { util } = Astro.props;
const t = Astro.locals.t;
const links = loadReferences(util);
const files = loadReferenceFiles(util);
const repoBlob = 'https://github.com/brazilian-utils/api-validator/blob/main/';
---

{links.length === 0 && files.length === 0 ? (
  <p>{t('references.none')}</p>
) : (
  <>
    {links.length > 0 && (
      <ul class="references">
        {links.map((ref) => (
          <li>
            <a href={ref.url} rel="noopener noreferrer" target="_blank">{ref.title}</a>
          </li>
        ))}
      </ul>
    )}
    {files.length > 0 && (
      <details class="local-copies">
        <summary>{t('references.localCopy')} ({files.length})</summary>
        <ul>
          {files.map((file) => (
            <li>
              <a href={repoBlob + encodeURI(file.repoPath)} rel="noopener noreferrer" target="_blank">{file.name}</a>
            </li>
          ))}
        </ul>
      </details>
    )}
  </>
)}

<style>
  .local-copies summary {
    cursor: pointer;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .local-copies ul {
    font-size: var(--sl-text-sm);
    word-break: break-word;
  }
</style>
