---
/**
 * A contract function's signature as type, under its heading: the function id, each parameter
 * with its type, and the return type. Same text as the contract (`cpf.isValid(cpf: string) →
 * boolean`), set so the eye finds the name and the types.
 */
import { loadOperation } from '@lib/registry.mjs';

interface Props {
  fn: string;
}
const found = loadOperation(Astro.props.fn);
const op = found?.op;
---

{op && (
  <p class="signature not-content">
    <code>
      <span class="name">{op.fnId}</span>(
      {op.params.map((p: any, i: number) => (
        <>
          {i > 0 && ', '}
          <span class="param">{p.name}{p.optional ? '?' : ''}</span>: <span class="type">{p.type}</span>
        </>
      ))}
      ) <span aria-hidden="true">→</span><span class="sr-only">returns</span> <span class="type">{op.returns}</span>
    </code>
  </p>
)}

<style>
  .signature {
    margin: 0.35rem 0 0;
    font-size: var(--sl-text-sm);
    line-height: 1.6;
  }
  code {
    font-family: var(--sl-font-mono);
    background: none;
    padding: 0;
    color: var(--sl-color-gray-3);
    overflow-wrap: anywhere;
  }
  .name {
    color: var(--sl-color-white);
    font-weight: 700;
  }
  .param {
    color: var(--sl-color-gray-1);
  }
  .type {
    color: var(--bu-link);
  }
</style>
