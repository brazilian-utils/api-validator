---
/**
 * Renders the long-form spec of a domain, contract/<domain>/spec.pt-BR.md or spec.en.md, as-is.
 * Falls back to the other language with a notice when the translation does not exist yet.
 * Domains without a long-form spec render nothing: their operations carry the contract's
 * description on the page.
 */
import { getEntry, render } from 'astro:content';
import { Aside } from '@astrojs/starlight/components';
import { loadSpec } from '@lib/registry.mjs';

interface Props {
  util: string;
}

const { util } = Astro.props;
const { lang } = Astro.locals.starlightRoute;
const t = Astro.locals.t;

const spec = loadSpec(util);
const domain = spec?.domain ?? util;
const wanted = lang === 'pt-BR' ? 'pt-BR' : 'en';
const other = wanted === 'en' ? 'pt-BR' : 'en';
// Only look up the prose that exists (contract/<domain>/spec.<lang>.md); most domains have none.
const has = (l: 'en' | 'pt-BR') => spec?.hasSpec?.[l] ?? true;

let entry = has(wanted) ? await getEntry('specs', `${domain}/${wanted}`) : undefined;
let isFallback = false;
if (!entry && has(other)) {
  entry = await getEntry('specs', `${domain}/${other}`);
  isFallback = Boolean(entry);
}
const Content = entry ? (await render(entry)).Content : null;
---

{isFallback && <Aside type="caution">{t('spec.fallback')}</Aside>}

{Content && (
  <div class="spec-body">
    <Content />
  </div>
)}

<style is:global>
  /* The spec file starts with its own H1; the page already has one. */
  .spec-body > h1:first-child {
    display: none;
  }
</style>
