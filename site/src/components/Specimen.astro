---
/**
 * The home page's one bold element: type a Brazilian document number and see what the libraries
 * see. It tells which document it is, shows it formatted with the check digits highlighted, says
 * whether it is valid, and names the same check in every library. Runs the JavaScript library in
 * the browser; examples and names come from the contract and the last validator run.
 */
import { loadLibs, loadSpecs, loadStatus } from '@lib/registry.mjs';
import { RAW, pageContext } from '@lib/page';
import { isImplemented } from '@lib/text.mjs';

const t = Astro.locals.t;
const { locale, prefix } = pageContext(Astro);
const specs = loadSpecs();
const status = loadStatus();
const libs = loadLibs();

// Documents the field recognizes, in the order it tries them; `check` = check digits at the end.
const KINDS = [
  { domain: 'cpf', check: 2 },
  { domain: 'pis', check: 1 },
  { domain: 'cnh', check: 2 },
  { domain: 'cnpj', check: 2 },
  { domain: 'voterId', check: 2 },
  { domain: 'cep', check: 0 },
  { domain: 'licensePlate', check: 0 },
];
const kinds = KINDS.flatMap(({ domain, check }) => {
  const spec = specs.find((s) => s.domain === domain);
  const op = spec?.operations.find((o) => o.id === 'isValid');
  if (!spec || !op) return [];
  const example = op.tests.find((c) => c.returns === true)?.args[0];
  const names = libs
    .map((lib) => ({ lib: lib.label, symbol: status?.libs?.[lib.id]?.functions?.[op.fnId] }))
    .filter((x) => x.symbol && isImplemented(x.symbol))
    .map((x) => ({ lib: x.lib, symbol: x.symbol.symbol }));
  return [{ domain, check, title: spec.title[locale], href: `${prefix}/utils/${spec.id}/`, example, names }];
});
const first = kinds.find((k) => k.domain === 'cpf');
---

<section class="specimen not-content" aria-labelledby="specimen-label" data-kinds={JSON.stringify(kinds)}
  data-valid={t('specimen.valid')} data-invalid={t('specimen.invalid')} data-unknown={t('specimen.unknown')} data-check-one={t('specimen.checkDigits_one')} data-check-other={t('specimen.checkDigits_other', { count: '{n}', ...RAW })} data-same={t('specimen.sameCheck')}>
  <label id="specimen-label" for="specimen-input">{t('specimen.label')}</label>
  <input id="specimen-input" type="text" inputmode="text" autocomplete="off" spellcheck="false" value={first?.example ?? ''} aria-describedby="specimen-result" />
  <p class="formatted" aria-hidden="true"></p>
  <div id="specimen-result" class="result" aria-live="polite"></div>
  <p class="examples">
    {t('specimen.examples')}
    {kinds.filter((k) => k.example).map((k) => (
      <button type="button" data-value={k.example}>{k.title}</button>
    ))}
  </p>
</section>

<script>
  // One entry point per function, so the page loads these 14 functions and not the whole package
  // (the try-it box loads the whole package, only when opened).
  import { formatCep } from '@brazilian-utils/brazilian-utils/format-cep';
  import { formatCnh } from '@brazilian-utils/brazilian-utils/format-cnh';
  import { formatCnpj } from '@brazilian-utils/brazilian-utils/format-cnpj';
  import { formatCpf } from '@brazilian-utils/brazilian-utils/format-cpf';
  import { formatLicensePlate } from '@brazilian-utils/brazilian-utils/format-license-plate';
  import { formatPis } from '@brazilian-utils/brazilian-utils/format-pis';
  import { formatVoterId } from '@brazilian-utils/brazilian-utils/format-voter-id';
  import { isValidCep } from '@brazilian-utils/brazilian-utils/is-valid-cep';
  import { isValidCnh } from '@brazilian-utils/brazilian-utils/is-valid-cnh';
  import { isValidCnpj } from '@brazilian-utils/brazilian-utils/is-valid-cnpj';
  import { isValidCpf } from '@brazilian-utils/brazilian-utils/is-valid-cpf';
  import { isValidLicensePlate } from '@brazilian-utils/brazilian-utils/is-valid-license-plate';
  import { isValidPis } from '@brazilian-utils/brazilian-utils/is-valid-pis';
  import { isValidVoterId } from '@brazilian-utils/brazilian-utils/is-valid-voter-id';

  type Kind = { domain: string; check: number; title: string; href: string; names: Array<{ lib: string; symbol: string }> };
  // `mask`: the written format of the document. A value typed with a mask says which document the
  // reader means, even when the same digits make another document valid.
  type Rule = { fits: (alnum: string) => boolean; mask?: RegExp; valid: (v: string) => boolean; format: (v: string) => string };
  const RULES: Record<string, Rule> = {
    cpf: { fits: (a) => /^\d{11}$/.test(a), mask: /^\d{3}\.\d{3}\.\d{3}-\d{2}$/, valid: isValidCpf, format: formatCpf },
    pis: { fits: (a) => /^\d{11}$/.test(a), mask: /^\d{3}\.\d{5}\.\d{2}-\d$/, valid: isValidPis, format: formatPis },
    cnh: { fits: (a) => /^\d{11}$/.test(a), valid: isValidCnh, format: formatCnh },
    cnpj: { fits: (a) => /^[0-9A-Z]{12}\d{2}$/.test(a), mask: /^[0-9A-Z]{2}\.[0-9A-Z]{3}\.[0-9A-Z]{3}\/[0-9A-Z]{4}-\d{2}$/i, valid: (v) => isValidCnpj(v, { version: 2 }), format: (v) => formatCnpj(v, { version: 2 }) },
    voterId: { fits: (a) => /^\d{12}$/.test(a), valid: isValidVoterId, format: formatVoterId },
    cep: { fits: (a) => /^\d{8}$/.test(a), mask: /^\d{5}-\d{3}$/, valid: isValidCep, format: formatCep },
    licensePlate: { fits: (a) => /^[A-Z]{3}\d[A-Z0-9]\d{2}$/.test(a), valid: isValidLicensePlate, format: (v) => formatLicensePlate(v) || v },
  };

  const box = document.querySelector<HTMLElement>('.specimen');
  if (box) {
    const kinds: Kind[] = JSON.parse(box.dataset.kinds!);
    const input = box.querySelector('input')!;
    const formatted = box.querySelector('.formatted')!;
    const result = box.querySelector('.result')!;

    // Which document the value is: the one whose mask it is written in, else the first that fits
    // and is valid, else the first that fits.
    const detect = (value: string) => {
      const alnum = value.toUpperCase().replace(/[^0-9A-Z]/g, '');
      const fitting = kinds.filter((k) => RULES[k.domain]?.fits(alnum));
      return fitting.find((k) => RULES[k.domain].mask?.test(value)) ?? fitting.find((k) => RULES[k.domain].valid(value)) ?? fitting[0];
    };

    /** The formatted value, with its last `check` digits marked. */
    const render = (text: string, check: number) => {
      formatted.textContent = '';
      let left = check;
      let cut = text.length;
      while (left > 0 && cut > 0) if (/[0-9A-Z]/i.test(text[--cut])) left--;
      formatted.append(text.slice(0, cut));
      if (check) {
        const mark = document.createElement('mark');
        mark.textContent = text.slice(cut);
        formatted.append(mark);
      }
    };

    const update = () => {
      const value = input.value.trim();
      const kind = value ? detect(value) : undefined;
      result.textContent = '';
      if (!kind) {
        formatted.textContent = value || ' ';
        if (value) result.append(box.dataset.unknown!);
        return;
      }
      const rule = RULES[kind.domain];
      const valid = rule.valid(value);
      render(rule.format(value) || value, valid ? kind.check : 0);
      const head = document.createElement('p');
      const link = document.createElement('a');
      link.href = kind.href;
      link.textContent = kind.title;
      const verdict = document.createElement('span');
      verdict.className = valid ? 'bu-ok' : 'bu-fail';
      verdict.textContent = `${valid ? '✓' : '✕'} ${valid ? box.dataset.valid : box.dataset.invalid}`;
      head.append(link, ': ', verdict, '.');
      if (valid && kind.check) head.append(` ${kind.check === 1 ? box.dataset.checkOne : box.dataset.checkOther!.replace('{n}', String(kind.check))}`);
      result.append(head);
      if (kind.names.length) {
        const caption = document.createElement('p');
        caption.className = 'same';
        caption.textContent = box.dataset.same!;
        result.append(caption);
        const list = document.createElement('dl');
        for (const n of kind.names) {
          const dt = document.createElement('dt');
          dt.textContent = n.lib;
          const dd = document.createElement('dd');
          const code = document.createElement('code');
          code.textContent = n.symbol;
          dd.append(code);
          list.append(dt, dd);
        }
        result.append(list);
      }
    };

    input.addEventListener('input', update);
    box.querySelectorAll<HTMLButtonElement>('.examples button').forEach((b) =>
      b.addEventListener('click', () => {
        input.value = b.dataset.value!;
        update();
        input.focus();
      }),
    );
    update();
  }
</script>

<style>
  .specimen {
    margin: 2rem 0 3rem;
    display: grid;
    gap: 0.75rem;
    max-width: 44rem;
  }
  label {
    font-size: var(--sl-text-lg);
    color: var(--sl-color-white);
  }
  input {
    font: inherit;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-2xl);
    padding: 0.6rem 0.8rem;
    border: 2px solid var(--sl-color-gray-4);
    border-radius: 0.25rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    width: 100%;
  }
  input:focus-visible {
    border-color: var(--sl-color-accent);
    outline-offset: 3px;
  }
  .formatted {
    margin: 0;
    font-family: var(--sl-font-mono);
    font-size: clamp(2rem, 7vw, 3.75rem);
    line-height: 1.1;
    letter-spacing: 0.02em;
    color: var(--sl-color-white);
    overflow-wrap: anywhere;
  }
  /* The one bold element: check digits under the brand yellow. */
  .formatted :global(mark) {
    background: var(--bu-yellow);
    color: #1d1f3d;
    padding: 0 0.08em;
    border-radius: 0.08em;
  }
  .result :global(p) {
    margin: 0;
    font-size: var(--sl-text-lg);
  }
  .result :global(a) {
    color: var(--bu-link);
    font-weight: 700;
  }
  .result :global(p.same) {
    margin-top: 1rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .result :global(dl) {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.2rem 1rem;
    margin: 0.35rem 0 0;
    font-size: var(--sl-text-sm);
  }
  .result :global(dt) {
    color: var(--sl-color-gray-3);
  }
  .result :global(dd) {
    margin: 0;
  }
  .examples {
    margin: 0.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .examples button {
    font: inherit;
    color: var(--bu-link);
    background: none;
    border: 0;
    padding: 0.25rem 0.1rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
</style>
