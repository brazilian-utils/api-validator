---
/**
 * "Try it": runs one contract operation in the browser with the reference library (JavaScript,
 * the version pinned in site/package.json, loaded only when the box opens). One input per contract
 * parameter, prefilled with the first shared case. When the inputs are a shared case, it says
 * whether the answer is the one the contract expects. Built from the contract and the last
 * validator run (the library's symbol), so every operation the published package has gets one.
 */
import { RAW } from '@lib/page';
import fs from 'node:fs';
import path from 'node:path';
import * as reference from '@brazilian-utils/brazilian-utils';
import { loadLibs, loadSpec, loadStatus } from '@lib/registry.mjs';
import { isImplemented } from '@lib/text.mjs';

interface Props {
  util: string;
  op: string;
}
const { util, op: opId } = Astro.props;
const t = Astro.locals.t;
const LIB = 'javascript';
const lib = loadLibs().find((l) => l.id === LIB);
const op = loadSpec(util)?.operations.find((o) => o.id === opId);
const fn = op && loadStatus()?.libs?.[LIB]?.functions?.[op.fnId];
// The symbol comes from the library's main branch; the box needs it in the published package.
const usable = lib && op && isImplemented(fn) && typeof (reference as Record<string, unknown>)[fn.symbol] === 'function';
const version = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'node_modules/@brazilian-utils/brazilian-utils/package.json'), 'utf8')).version;

const kind = (type: string) => {
  const parts = type.split('|').map((s) => s.trim());
  if (parts.includes('string')) return 'string';
  if (parts.includes('number')) return 'number';
  if (parts.includes('date')) return 'date';
  if (parts.includes('boolean')) return 'boolean';
  return 'json';
};
const first = op?.tests.find((c: any) => Array.isArray(c.args)) ?? { args: [] };
const params = (op?.params ?? []).map((p: any, i: number) => {
  const k = kind(p.type);
  const v = first.args[i];
  const value = v === undefined ? '' : k === 'json' ? JSON.stringify(v) : String(v);
  return { ...p, kind: k, value, id: `try-${op!.fnId.replace('.', '-')}-${p.name}` };
});
// Shared cases with a fixed answer, to say whether the answer shown is the contract's.
const cases = (op?.tests ?? []).filter((c: any) => 'returns' in c).map((c: any) => ({ args: c.args, returns: c.returns }));
---

{usable && (
  <details class="try-it bu-disclosure not-content" data-symbol={fn.symbol} data-cases={JSON.stringify(cases)} data-kinds={JSON.stringify(params.map((p: any) => p.kind))} data-msg-ok={t('try.matches')} data-msg-differs={t('try.differs')}>
    <summary>{t('try.title', { ...RAW, lib: lib!.label })} <code>{fn.symbol}</code></summary>
    <form>
      {params.map((p: any) => (
        <label for={p.id}>
          <span>{p.name}{p.optional ? '?' : ''} <small>{p.type}</small></span>
          {p.kind === 'boolean' ? (
            <input id={p.id} name={p.name} type="checkbox" checked={p.value === 'true'} />
          ) : (
            <input id={p.id} name={p.name} type={p.kind === 'number' ? 'number' : 'text'} step="any" value={p.value} placeholder={p.kind === 'json' ? '{ } JSON' : p.kind === 'date' ? '2026-01-31' : ''} autocomplete="off" spellcheck="false" />
          )}
        </label>
      ))}
      <button type="submit">{t('try.run')}</button>
    </form>
    <output aria-live="polite"><span class="muted">{t('try.hint')}</span></output>
    <p class="note">{t('try.note', { ...RAW, package: `${lib!.package} ${version}` })}</p>
  </details>
)}

<script>
  let reference: Promise<Record<string, (...args: unknown[]) => unknown>> | undefined;
  const text = (v: unknown) => (v === undefined ? 'undefined' : JSON.stringify(v, (_, x) => (x instanceof Date ? x.toISOString() : x)));

  for (const box of document.querySelectorAll<HTMLDetailsElement>('details.try-it')) {
    const form = box.querySelector('form')!;
    const out = box.querySelector('output')!;
    const kinds: string[] = JSON.parse(box.dataset.kinds!);
    const cases: Array<{ args: unknown[]; returns: unknown }> = JSON.parse(box.dataset.cases!);
    const inputs = [...form.querySelectorAll('input')];
    let seq = 0;

    const args = () => {
      const list = inputs.map((input, i) => {
        const kind = kinds[i];
        if (kind === 'boolean') return input.checked;
        const v = input.value;
        if (v === '') return undefined;
        if (kind === 'number') return Number(v);
        if (kind === 'date') return new Date(v);
        if (kind === 'json') return JSON.parse(v);
        return v;
      });
      while (list.length && list[list.length - 1] === undefined) list.pop();
      return list;
    };

    const show = (...parts: Array<[string, string]>) =>
      out.replaceChildren(...parts.map(([cls, content]) => Object.assign(document.createElement(cls === 'value' ? 'code' : 'span'), { className: cls, textContent: content })));

    const run = async () => {
      const n = ++seq;
      // The library loads once, on the first run; a failed load is retried on the next one.
      reference ??= import('@brazilian-utils/brazilian-utils').catch((error) => {
        reference = undefined;
        throw error;
      }) as typeof reference;
      try {
        const input = args();
        const result = await (await reference!)[box.dataset.symbol!](...input);
        if (n !== seq) return; // a newer run started while this one waited
        const known = cases.find((c) => JSON.stringify(c.args) === JSON.stringify(input));
        const same = known && JSON.stringify(known.returns) === JSON.stringify(result ?? null);
        show(['value', text(result)], ...(known ? [[same ? 'bu-ok' : 'bu-fail', same ? box.dataset.msgOk! : `${box.dataset.msgDiffers!} ${text(known.returns)}`] as [string, string]] : []));
      } catch (error) {
        if (n === seq) show(['bu-fail', String((error as Error)?.message ?? error)]);
      }
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      run();
    });
    // Answers as you type once the box is open: it is a playground, not a form.
    let timer: number | undefined;
    form.addEventListener('input', () => {
      clearTimeout(timer);
      timer = window.setTimeout(run, 250);
    });
    box.addEventListener('toggle', () => box.open && run(), { once: true });
  }
</script>

<style>
  summary code { font-weight: 400; margin-inline-start: 0.25rem; }
  form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: end;
    padding: 0 0.9rem 0.75rem;
  }
  label {
    display: grid;
    gap: 0.2rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    flex: 1 1 12rem;
  }
  small { font-family: var(--sl-font-mono); }
  input[type='text'],
  input[type='number'] {
    font: inherit;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
    padding: 0.4rem 0.55rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.35rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
  }
  button {
    font: inherit;
    font-size: var(--sl-text-sm);
    padding: 0.4rem 0.9rem;
    border: 0;
    border-radius: 0.35rem;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    cursor: pointer;
  }
  output {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    margin: 0 0.9rem 0.6rem;
    padding: 0.55rem 0.75rem;
    border-radius: 0.35rem;
    background: var(--sl-color-bg);
    font-size: var(--sl-text-sm);
    min-height: 2.4rem;
  }
  output :global(span) { font-size: var(--sl-text-xs); }
  .muted,
  .note { color: var(--sl-color-gray-3); }
  .note { font-size: var(--sl-text-xs); margin: 0 0.9rem 0.7rem; }
</style>
