---
/**
 * How to call one contract operation in each library: one tab per library (order and default
 * tab from libs/*.json), synced across the whole site with syncKey="lang".
 *
 * Tab content is the `## <operation>` section of `<lib repo>/docs/usage/<util>.md`, fetched at
 * build time into .cache/usage/ by scripts/fetch-libs.mjs.
 */
import { getCollection, render } from 'astro:content';
import { Tabs, TabItem } from '@astrojs/starlight/components';
import { loadLibs, loadStatus, LANG_PREFIX } from '@lib/registry.mjs';

interface Props {
  util: string;
  op: string;
  fn: string;
}

const { util, op, fn } = Astro.props;
const { lang } = Astro.locals.starlightRoute;
const t = Astro.locals.t;
const locale = lang === 'pt-BR' ? 'pt-BR' : 'en';
const libs = loadLibs();
const status = loadStatus();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = LANG_PREFIX[locale] ? `${base}/${LANG_PREFIX[locale]}` : base;

const entries = await getCollection('usage', (entry) => entry.data.util === util && entry.data.op === op);
const pick = (libId: string) => {
  const mine = entries.filter((e) => e.data.lib === libId);
  return mine.find((e) => e.data.locale === locale) ?? mine.find((e) => e.data.locale === 'en') ?? mine[0];
};

const tabs = await Promise.all(
  libs.map(async (lib) => {
    const entry = pick(lib.id);
    const Content = entry ? (await render(entry)).Content : null;
    const implemented = ['ok', 'failing'].includes(status?.libs[lib.id]?.functions?.[fn]?.status);
    return { lib, entry, Content, implemented };
  }),
);
---

<Tabs syncKey="lang">
  {tabs.map(({ lib, entry, Content, implemented }) => (
    <TabItem label={lib.label} icon={lib.icon as any}>
      {Content ? (
        <div class="usage-body">
          <Content />
          {entry?.data.source && (
            <p class="usage-source not-content">
              <a href={entry.data.source} rel="noopener noreferrer" target="_blank">{t('usage.source')}: {lib.repo}</a>
            </p>
          )}
        </div>
      ) : (
        <p class="usage-missing">
          {implemented ? t('usage.undocumented', { lib: lib.label }) : t('usage.notAvailable', { lib: lib.label })}{' '}
          <a href={implemented ? `${prefix}/contributing/usage-files/` : `${prefix}/contributing/new-language/`}>{t('usage.contribute')}</a>
        </p>
      )}
    </TabItem>
  ))}
</Tabs>

<style>
  .usage-missing {
    color: var(--sl-color-gray-3);
    border: 1px dashed var(--sl-color-hairline);
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
  }
  .usage-source {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-4);
    margin-top: 0.25rem;
  }
  .usage-source a { color: inherit; }
</style>
