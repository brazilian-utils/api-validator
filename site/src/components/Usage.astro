---
/**
 * "Usage" section of a utility page.
 *
 * For each operation declared in specs/<util>/meta.yaml, renders one tab per library
 * (order and default tab come from libs.yaml). Tab content is the matching section of
 * `<lib repo>/docs/usage/<util>.md`, fetched at build time into .cache/usage/.
 *
 * All tab groups share syncKey="lang", so picking a language once applies to the whole site.
 */
import { getCollection, render } from 'astro:content';
import { Tabs, TabItem } from '@astrojs/starlight/components';
import { loadLibs, loadSpec, LANG_PREFIX } from '@lib/registry.mjs';

interface Props {
  util: string;
}

const { util } = Astro.props;
const { lang } = Astro.locals.starlightRoute;
const t = Astro.locals.t;
const locale = lang === 'pt-BR' ? 'pt-BR' : 'en';

const meta = loadSpec(util);
const libs = loadLibs();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = LANG_PREFIX[locale] ? `${base}/${LANG_PREFIX[locale]}` : base;

const entries = await getCollection('usage', (entry) => entry.data.util === util);

// Pick, for each (lib, op), the entry in the page language, else the default (en) one.
function pick(libId: string, opId: string) {
  const candidates = entries.filter((e) => e.data.lib === libId && e.data.op === opId);
  return candidates.find((e) => e.data.locale === locale) ?? candidates.find((e) => e.data.locale === 'en') ?? candidates[0];
}

const sections = await Promise.all(
  (meta?.operations ?? []).map(async (op) => ({
    op,
    tabs: await Promise.all(
      libs.map(async (lib) => {
        const entry = pick(lib.id, op.id);
        const Content = entry ? (await render(entry)).Content : null;
        return { lib, entry, Content };
      }),
    ),
  })),
);
---

{sections.map(({ op, tabs }) => (
  <section class="usage-op">
    <h3 id={`usage-${op.id}`}>{op.label[locale]}</h3>
    <Tabs syncKey="lang">
      {tabs.map(({ lib, entry, Content }) => (
        <TabItem label={lib.label} icon={lib.icon as any}>
          {Content ? (
            <div class="usage-body">
              <Content />
              {entry?.data.source && (
                <p class="usage-source not-content">
                  <a href={entry.data.source} rel="noopener noreferrer" target="_blank">{t('usage.source')}: {lib.repo}</a>
                </p>
              )}
            </div>
          ) : (
            <p class="usage-missing">
              {t('usage.notAvailable', { lib: lib.label })}{' '}
              <a href={`${prefix}/contributing/new-language/`}>{t('usage.contribute')}</a>
            </p>
          )}
        </TabItem>
      ))}
    </Tabs>
  </section>
))}

<style>
  .usage-op + .usage-op {
    margin-top: 2rem;
  }
  .usage-op h3 {
    margin-bottom: 0.5rem;
  }
  .usage-missing {
    color: var(--sl-color-gray-3);
    border: 1px dashed var(--sl-color-hairline);
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
  }
  .usage-source {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-4);
    margin-top: 0.25rem;
  }
  .usage-source a {
    color: inherit;
  }
</style>
