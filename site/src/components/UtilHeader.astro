---
/**
 * Top of a utility page: one-line summary, one badge per library (how many of the domain's
 * operations it implements, from the last api-validator run; from the usage files when the
 * site is built without status), and links to related utilities.
 */
import { getCollection } from 'astro:content';
import { Badge } from '@astrojs/starlight/components';
import { loadLibs, loadSpec, loadSpecs, loadStatus, LANG_PREFIX } from '@lib/registry.mjs';

interface Props {
  util: string;
}

const { util } = Astro.props;
const { lang } = Astro.locals.starlightRoute;
const t = Astro.locals.t;
const locale = lang === 'pt-BR' ? 'pt-BR' : 'en';
const meta = loadSpec(util);
const libs = loadLibs();
const status = loadStatus();
const allSpecs = loadSpecs();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = LANG_PREFIX[locale] ? `${base}/${LANG_PREFIX[locale]}` : base;
const total = meta?.operations.length ?? 0;
const usage = await getCollection('usage', (entry) => entry.data.util === util);

const availability = libs.map((lib) => {
  const fns = status?.libs[lib.id]?.functions;
  let count;
  let failing = 0;
  if (fns) {
    const mine = (meta?.operations ?? []).map((op) => fns[op.fnId]).filter(Boolean);
    count = mine.filter((f) => f.status === 'ok' || f.status === 'failing').length;
    failing = mine.filter((f) => f.status === 'failing').length;
  } else {
    count = new Set(usage.filter((e) => e.data.lib === lib.id).map((e) => e.data.op)).size;
  }
  const since = usage.find((e) => e.data.lib === lib.id && e.data.since)?.data.since;
  return { lib, count, failing, since };
});

const related = (meta?.related ?? []).map((id) => allSpecs.find((s) => s.id === id)).filter(Boolean);
---

{meta && (
  <div class="util-header not-content">
    <p class="summary">{meta.summary[locale]}</p>

    <div class="availability">
      <span class="label">{t('util.implementedIn')}</span>
      <ul>
        {availability.map(({ lib, count, failing, since }) => (
          <li>
            <a href={`${prefix}/libs/${lib.id}/`}>
              <Badge
                text={`${lib.label} ${count}/${total}` + (since ? ` · ${t('util.since', { version: since })}` : '')}
                variant={count === 0 ? 'default' : failing > 0 ? 'caution' : count >= total ? 'success' : 'tip'}
                size="medium"
                class:list={[{ 'is-missing': count === 0 }]}
              />
            </a>
          </li>
        ))}
      </ul>
    </div>

    {related.length > 0 && (
      <p class="related">
        <span class="label">{t('util.related')}</span>
        {related.map((spec, i) => (
          <>
            <a href={`${prefix}/utils/${spec!.id}/`}>{spec!.title[locale]}</a>{i < related.length - 1 ? ', ' : ''}
          </>
        ))}
      </p>
    )}
  </div>
)}

<style>
  .util-header {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }
  .summary {
    font-size: var(--sl-text-lg);
    color: var(--sl-color-gray-2);
    max-width: 70ch;
    margin: 0;
  }
  .availability,
  .related {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: var(--sl-text-sm);
  }
  .label {
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    margin-inline-end: 0.25rem;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li { margin: 0; }
  li a { text-decoration: none; }
  :global(.util-header .is-missing) {
    opacity: 0.55;
  }
</style>
