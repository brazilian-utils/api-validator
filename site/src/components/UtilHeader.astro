---
/**
 * Top of a utility page: one-line summary, one badge per library
 * (available / not yet), and links to related utilities.
 * Availability comes from the usage files fetched from each library repo.
 */
import { getCollection } from 'astro:content';
import { Badge } from '@astrojs/starlight/components';
import { loadLibs, loadSpec, loadSpecs, LANG_PREFIX } from '@lib/registry.mjs';

interface Props {
  util: string;
}

const { util } = Astro.props;
const { lang } = Astro.locals.starlightRoute;
const t = Astro.locals.t;
const meta = loadSpec(util);
const libs = loadLibs();
const allSpecs = loadSpecs();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = LANG_PREFIX[lang as 'en' | 'pt-BR'] ? `${base}/${LANG_PREFIX[lang as 'en' | 'pt-BR']}` : base;

const usage = await getCollection('usage', (entry) => entry.data.util === util);
const opsTotal = meta?.operations.length ?? 0;

const availability = libs.map((lib) => {
  const entries = usage.filter((e) => e.data.lib === lib.id);
  const ops = new Set(entries.map((e) => e.data.op));
  const since = entries.find((e) => e.data.since)?.data.since;
  return { lib, count: ops.size, since, available: ops.size > 0, full: opsTotal > 0 && ops.size >= opsTotal };
});

const related = (meta?.related ?? [])
  .map((id) => allSpecs.find((s) => s.id === id))
  .filter(Boolean);
---

{meta && (
  <div class="util-header not-content">
    <p class="summary">{meta.summary[lang as 'en' | 'pt-BR']}</p>

    <div class="availability">
      <span class="label">{t('util.implementedIn')}</span>
      <ul>
        {availability.map(({ lib, available, full, since }) => (
          <li>
            <Badge
              text={lib.label + (since ? ` · ${t('util.since', { version: since })}` : '')}
              variant={available ? (full ? 'success' : 'tip') : 'default'}
              size="medium"
              class:list={[{ 'is-missing': !available }]}
            />
          </li>
        ))}
      </ul>
    </div>

    {related.length > 0 && (
      <p class="related">
        <span class="label">{t('util.related')}</span>
        {related.map((spec, i) => (
          <>
            <a href={`${prefix}/utils/${spec!.id}/`}>{spec!.title[lang as 'en' | 'pt-BR']}</a>{i < related.length - 1 ? ', ' : ''}
          </>
        ))}
      </p>
    )}
  </div>
)}

<style>
  .util-header {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }
  .summary {
    font-size: var(--sl-text-lg);
    color: var(--sl-color-gray-2);
    max-width: 70ch;
    margin: 0;
  }
  .availability,
  .related {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: var(--sl-text-sm);
  }
  .label {
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    margin-inline-end: 0.25rem;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li { margin: 0; }
  :global(.util-header .is-missing) {
    opacity: 0.55;
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }
</style>
