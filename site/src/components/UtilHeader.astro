---
/**
 * Top of a utility page: the one-line summary; how many of the domain's operations each library
 * implements (from the last api-validator run, or from the usage files without one); the guides
 * that use it; related utilities.
 */
import { getCollection } from 'astro:content';
import { coverage, loadGuides, loadLibs, loadSpec } from '@lib/registry.mjs';
import { RAW, pageContext } from '@lib/page';

interface Props {
  util: string;
}

const { util } = Astro.props;
const t = Astro.locals.t;
const { locale, prefix } = pageContext(Astro);
const spec = loadSpec(util);
const libs = loadLibs();
const usage = await getCollection('usage', (entry) => entry.data.util === util);
// Same marks as the parity matrix: all functions ✓, some ◐, a failing case ✕, none ○.
const MARK = { full: ['✓', 'bu-ok'], partial: ['◐', 'bu-warn'], failing: ['✕', 'bu-fail'], none: ['○', 'bu-none'] } as const;

const availability = spec
  ? libs.map((lib) => {
      const { count, failing, total, state } = coverage(spec, lib.id);
      // The version the library first shipped this utility in, when its usage file says (`since:`).
      const since = usage.find((e) => e.data.lib === lib.id && e.data.since)?.data.since;
      return { lib, count, failing, total, since, mark: MARK[state][0], cls: MARK[state][1] };
    })
  : [];

const related = (spec?.related ?? []).map((id) => loadSpec(id)).filter(Boolean);
const fnIds = new Set((spec?.operations ?? []).map((op) => op.fnId));
const guides = loadGuides().filter((g) => g.fns.some((fn: string) => fnIds.has(fn)));
const libLabel = (id: string) => libs.find((l) => l.id === id)?.label ?? id;
---

{spec && (
  <div class="util-header not-content">
    <p class="summary">{spec.summary[locale]}</p>

    <p class="row">
      <span class="label">{t('util.implementedIn')}</span>
      {availability.map(({ lib, count, failing, total, mark, cls, since }) => (
        <a href={`${prefix}/libs/${lib.id}/`} class:list={['lib', { none: count === 0 }]}>
          <span class={cls} aria-hidden="true">{mark}</span>
          {lib.label}
          <span class="count">{t('util.count', { ...RAW, count, total })}{since && ` ${t('util.since', { ...RAW, version: since })}`}</span>
          {failing > 0 && <span class="sr-only">{t('status.failing')}</span>}
        </a>
      ))}
    </p>

    {guides.length > 0 && (
      <p class="row">
        <span class="label">{t('util.guides')}</span>
        {guides.map((g) => (
          <a href={`${prefix}/guides/${g.lib}/${g.slug}/`}>{t('util.guideFrom', { ...RAW, title: g.title[locale] ?? g.title.en, lib: libLabel(g.lib) })}</a>
        ))}
      </p>
    )}

    {related.length > 0 && (
      <p class="row">
        <span class="label">{t('util.related')}</span>
        {related.map((r) => <a href={`${prefix}/utils/${r!.id}/`}>{r!.title[locale]}</a>)}
      </p>
    )}
  </div>
)}

<style>
  .util-header {
    display: grid;
    gap: 0.6rem;
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }
  .summary {
    font-size: var(--sl-text-xl);
    line-height: 1.45;
    color: var(--sl-color-white);
    max-width: 60ch;
    margin: 0 0 0.4rem;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    margin: 0;
    font-size: var(--sl-text-sm);
  }
  .label {
    color: var(--sl-color-gray-3);
    min-width: 7.5rem;
  }
  .row a {
    color: var(--bu-link);
  }
  .lib {
    display: inline-flex;
    gap: 0.3rem;
    text-decoration: none;
    color: var(--sl-color-gray-1) !important;
  }
  .lib:hover {
    text-decoration: underline;
  }
  .lib.none {
    color: var(--sl-color-gray-3) !important;
  }
  .count {
    color: var(--sl-color-gray-3);
    font-variant-numeric: tabular-nums;
  }
</style>
